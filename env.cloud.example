# Kartin Cloud — control + tenant plane example
# Copy to .env and adjust for your environment.

# --- Shared ---
AUTH_SECRET=change-me-min-32-characters-long
NODE_ENV=production

# --- Deployment mode ---
# SaaS-only default: self-hosted VPS path disabled until re-enabled
ENABLE_SELF_HOSTED=false
NEXT_PUBLIC_ENABLE_SELF_HOSTED=false

# --- Control plane (portal.kartin.ir) ---
KARTIN_PLANE=control
KARTIN_MODE=cloud
KARTIN_BASE_DOMAIN=kartin.ir
SETUP_HOST=portal.kartin.ir
NEXTAUTH_URL=https://portal.kartin.ir
DATABASE_URL=postgresql://kartin:PASSWORD@db:5432/kartin
DATABASE_URL_CONTROL=postgresql://kartin:PASSWORD@db:5432/kartin_control
TENANT_DATABASE_URL_TEMPLATE=postgresql://kartin:PASSWORD@db:5432/kartin_{slug}
PROVISIONING_SECRET=long-random-internal-secret

# --- Tenant plane ({slug}.kartin.ir) ---
# KARTIN_PLANE=tenant
# KARTIN_MODE=cloud
# KARTIN_BASE_DOMAIN=kartin.ir
# NEXTAUTH_URL=https://acme.kartin.ir
# DATABASE_URL=postgresql://kartin:PASSWORD@db:5432/kartin_acme
# UPLOAD_DIR=/app/uploads
# MAX_UPLOAD_MB=10

# --- SMS OTP ---
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Dev / client (tenant app — link to setup portal from install/pending page)
NEXT_PUBLIC_SETUP_PORTAL_URL=http://localhost:5568/setup
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_TENANT_PORT=5568

# --- Docker/nginx provisioning (optional) ---
# NGINX_SITES_DIR=/etc/nginx/conf.d/tenants
# NGINX_RELOAD_CMD=nginx -s reload
# TENANT_INTERNAL_HOST=kartin-app:3000

# --- Local unified dev (single container, docker-compose.yml) ---
# KARTIN_UNIFIED_DEV=true

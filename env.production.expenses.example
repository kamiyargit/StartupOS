# Production .env for /opt/kartin on VPS (expenses.cuty.center)
# Copy: scp env.production.expenses.example root@VPS:/opt/kartin/.env
#
# IMPORTANT: wrap passwords in double quotes if they contain # % ! < : / or spaces.
# DATABASE_URL is built at container start with URL-encoding (see docker/entrypoint.prod.sh).

POSTGRES_USER=kartin
POSTGRES_PASSWORD="replace-with-strong-db-password"
POSTGRES_DB=kartin

AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"
NEXTAUTH_URL=https://expenses.cuty.center

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kartin.local
ADMIN_PASSWORD="replace-with-strong-admin-login-password"

MAX_UPLOAD_MB=10

# Join cuty-platform reverse-proxy network
CUTY_DOCKER_NETWORK=cuty-platform_cuty-network

# Build-only (local PC) — optional
# NODE_IMAGE=docker.arvancloud.ir/library/node:22-alpine
# NPM_REGISTRY=https://registry.npmmirror.com/
